Name	 VGA_BITPRO;
PartNo   VGA_BITPRO;
Date     03/30/2024;
Revision 01;
Designer Sponaugle;
Company  Ratiometric;
Assembly None;
Location None;
Device   f1508isptqfp100;

PROPERTY ATMEL {TDI_PULLUP = ON};
PROPERTY ATMEL {TMS_PULLUP = ON};
PROPERTY ATMEL {PREASSIGN = KEEP};
PROPERTY ATMEL {XOR_SYNTHESIS = ON};



// INPUTS
Pin[87] = DOT_CLK;
Pin[89] = nSYS_RESET;
Pin[17,23,24,29,31,32,33,35,37,40,41,42,44,45,46,48,52,63,68,69,70,71,72,76,77,78,79,80,81,83,84,85] = [VMEM_D0..31];        // 16 bit input from video memory
Pin[6,20,22,36,64,65,67,75] = [FONTROM_D0..7];      // 8 bit input from font rom
Pin[1,100] = [MODE0..1];    // 00 = Text Mode   (MODE1==0)
                            // 10 = Graphics Mode 640x480 16bpp
                            // 11 = Graphics Mode 648x480 8bpp
                            // 10 = Undefined
                            // b1 = 0 for TEXT, 1 for Graphics
                            // b0 = 0f for 16bpp, 1 for 8bpp
Pin[10] = LATCH_VRAM;           // If high, on the next dot clock we will latch the VMEM pins into the 32bit pixel register
                            // and immediatly drive the RGB output based on the 16 bit value if we are in graphics mode.
Pin[2] = LATCH_SREG;           // If high, on the next dot clock we will latch the FONTROM in the shift register
Pin[25] = SHIFT_SREG;           // If high, on the next dot clock the shift register will shift legft

Pin[90] = VGA_ENABLE;           // If high, the data outputs are turned on.  If we are in text mode the data output is based on bit 7
                            // of the shift register, and if we are in graphics mode the output is based on the 16 bit value in
                            // the VMEM registers.
Pin[13,12] = [SELECT_SUB0..1];     // In text mode SELECT is not used.
                            // In 16bpp graphics mode SELECT will pick one of 2 pixels. SUB0
                            // In 8bpp graphics mode, SELECT will pick one of 4 pixels. SUB1:SUB0

Pin[8] = INVERT_SELECT;        // If high, the cursor effect should be turned on.  This will invert what is being displayed.
Pin[94] = STATUS;

// OUTPUTS
Pin[14,16,19,21,28] = [RED0..4];
Pin[5,7,9,27,30] = [GREEN0..4];
Pin[92,93,96,97,98] = [BLUE0..4];
Pin[61,60,58,57,56,55,54,53,50,49,47] = [FONT_ADDRESS0..10];   // Output to address lines of font memory to select character
                            // 8 bits from the character itself, and 3 bits from the attribute

Pin[99] = BLINK_TIMER;
// NODES

PINNODE = [SREG_D0..7];      // Shift Register - Pixel Data
PINNODE = [AREG_D0..23];     // Attribute register -save the attribute to use while SREG outputs
PINNODE = [VREG_D0..31];     // Memory Register - In graphics mode all 16 bits are used for pixel data
                            /*
                             
                             In text mode, we use all 32 bits for character and atribute
                             TEXT MODE:  
                                              9 bits (512) Foreground colors
                                              9 bits (512) Background colors   
                                              D0..D7 = The character code (sent to FONTROM)
                                              D8-D31 = The character attribute 
                                                                 
                                               b8-b10  AREG0-2   - Foreground Red
                                               b11-b13 AREG3-5   - Foreground Green
                                               b14-b16 AREG6-8   - Foreground Blue
                                               b17-b19 AREG9-11  - Background Red
                                               b20-b22 AREG12-14 - Background Green
                                               b23-b25 AREG15-17 - Background Blue
                                               b26-b28 AREG18-20 - FONTSET0-2 (8 Fonts)
                                               b29     AREG21    - BLINK
                                               b30     AREG22    - INVERT
                                               b31     AREG23    - CURSOR 

                             GRAPHICS MODE 16bpp
                                         D0..D15  = [xBBBBB GGGGG RRRRR] pixel 1
                                         D16..D31 = [xBBBBB GGGGG RRRRR] pixel 2
                             
                             GRAPHICS MODE 8bpp
                                         D0-D7 =    [xxBBGGRR] pixel 1
                                         D8-D15 =   [xxBBGGRR] pixel 2
                                         D16-D23 =  [xxBBGGRR] pixel 3
                                         D24-D31 =  [xxBBGGRR] pixel 4
                            */

// The shift register used for the text mode
// HOLD statements

STATUS = INVERT_SELECT;

FIELD mode_field = [MODE0..1];
FIELD select_field = [SELECT_SUB1..0];

NO_SHIFT_CHANGE = !(LATCH_SREG # SHIFT_SREG);
SREG_D0.d = (LATCH_SREG & FONTROM_D0) # (NO_SHIFT_CHANGE & SREG_D0);
SREG_D1.d = (LATCH_SREG & FONTROM_D1) # (NO_SHIFT_CHANGE & SREG_D1) # (SHIFT_SREG & SREG_D0 );
SREG_D2.d = (LATCH_SREG & FONTROM_D2) # (NO_SHIFT_CHANGE & SREG_D2) # (SHIFT_SREG & SREG_D1 );
SREG_D3.d = (LATCH_SREG & FONTROM_D3) # (NO_SHIFT_CHANGE & SREG_D3) # (SHIFT_SREG & SREG_D2 );
SREG_D4.d = (LATCH_SREG & FONTROM_D4) # (NO_SHIFT_CHANGE & SREG_D4) # (SHIFT_SREG & SREG_D3 );
SREG_D5.d = (LATCH_SREG & FONTROM_D5) # (NO_SHIFT_CHANGE & SREG_D5) # (SHIFT_SREG & SREG_D4 );
SREG_D6.d = (LATCH_SREG & FONTROM_D6) # (NO_SHIFT_CHANGE & SREG_D6) # (SHIFT_SREG & SREG_D5 );
SREG_D7.d = (LATCH_SREG & FONTROM_D7) # (NO_SHIFT_CHANGE & SREG_D7) # (SHIFT_SREG & SREG_D6 );

[SREG_D0..7].ck = !DOT_CLK;
[SREG_D0..7].ar = !nSYS_RESET;

[AREG_D0..23].d =  ( LATCH_SREG & [VREG_D8..31] ) 
                # ( !LATCH_SREG & [AREG_D0..23]);
[AREG_D0..23].ck = !DOT_CLK;
[AREG_D0..23].ar = !nSYS_RESET;

[VREG_D0..31].d = (LATCH_VRAM & [VMEM_D0..31]) # (!LATCH_VRAM & [VREG_D0..31]);
[VREG_D0..31].ck = !DOT_CLK;
[VREG_D0..31].ar = !nSYS_RESET;

/*

        FONT_ADDRESS goes to the FONT ROM bits 4-15.  The lowest 4 bits of the FONT ROM address 
        comes from the FONT_ROW output from the SYNC CPLD.  The layout of the FONT ROM address space
        is as follows:

                bit 0-3:        4 bits to select the row of a given character.
                bit 4-11;       8 bits to select the particular character we are displaying
                bit 12-14;      3 bits to select the FONT family

        This means the FONT ROM uses 32K of space
*/

[FONT_ADDRESS0..7] = [VREG_D0..7];
[FONT_ADDRESS8..10] = [VREG_D26..28];


/*

For the color outputs, we have two different sources - one for text mode and one for graphics mode.
In TEXT MODE:
                COLOR = (a2 a1 a0 a0 a0) - lower 3 bits are the same.

In GRAPHICS MODE, 16bpp  (2 pixels in every 32bit value collected from VRAM)
                COLOR = xBBB BBGG GGGR RRRR direct from the pixel data, but with 2 pixel datas to select from.
                Since we have 5 bits of color output per color, this is a direct mapping.

In GRAPHICS MODE, 8bpp ( 4 pixels in every 32bit value collected from VRAM)
                COLOR = xxBBGGRR direct from the pixel data, but with 4 pixel datas to select from.
                Since we have 5 bits of color output per color, but only 2 bits of color data, we need to map:
                  00[0] -> 00000 [0]
                  01[1] -> 01011 [11]
                  10[2] -> 10101 [21]
                  11[3] -> 11111 [31]

                  This translates to (b1 b0 b1 b0 b0#b1) as the 5 output bits based on 2 input bits
                  We have to also handle the select_field values for the 4 different pixel source.
                  For example for the first pixel contained in VRAM_D0-D7:

                    REDb0 = D0
                    REDb1 = D1
                    GREENb0 = D2
                    GREENb1 = D3
                    BLUEb0 = D4
                    BLUEb1 = D5

                    and for RED, the 5 outputs bits will be

                    RED0 <- b0#b1
                    RED1 <- b0
                    RED2 <- b1
                    RED3 <- b0
                    RED4 <- b1

                    For example the RED0 will use
                                                                        b0       b1
                     ( mode_field['b'11] & ( ( select_field:['b'00] & (VREG_D0#VREG_D1) )
                                            #( select_field:['b'01] & (VREG_D8#VREG_D9) )
                                            #( select_field:['b'10] & (VREG_D16#VREG_D17) )
                                            #( select_field:['b'11] & (VREG_D24#VREG_D25) )
                     );

*/

// To make the expressions a bit easier to read we will make some dedicate expressions for the individual color bits when we
// are in 8bpp mode.  These expressions extract the color bits. 

REDb0ORb1 =  ( select_field:['b'00] & (VREG_D0#VREG_D1) )                 // first red pixel color bit 0 *OR* first red pixel color bit 1
            #( select_field:['b'01] & (VREG_D8#VREG_D9) )                 // second red pixel color bit 0 *OR* second red pixel color bit 1
            #( select_field:['b'10] & (VREG_D16#VREG_D17) )               // third red pixel color bit 0 *OR* third red pixel color bit 1
            #( select_field:['b'11] & (VREG_D24#VREG_D25) );              // forth red pixel color bit 0 *OR* forth red pixel color bit 1

REDb0 =  ( select_field:['b'00] & (VREG_D0) )                // first pixel
        #( select_field:['b'01] & (VREG_D8) )                // second pixel
        #( select_field:['b'10] & (VREG_D16) )               // third pixel 
        #( select_field:['b'11] & (VREG_D24) );              // fourth pixel

REDb1 =  ( select_field:['b'00] & (VREG_D1) )                 // first pixel
        #( select_field:['b'01] & (VREG_D9) )                 // second pixel
        #( select_field:['b'10] & (VREG_D17) )               // third pixel 
        #( select_field:['b'11] & (VREG_D25) );

GREENb0ORb1 = ( select_field:['b'00] & (VREG_D2#VREG_D3) )                 // first pixel
            #( select_field:['b'01] & (VREG_D10#VREG_D11) )                 // second pixel
            #( select_field:['b'10] & (VREG_D18#VREG_D19) )               // third pixel 
            #( select_field:['b'11] & (VREG_D26#VREG_D27) );              // fourth pixel

GREENb0 =  ( select_field:['b'00] & (VREG_D2) )                // first pixel
          #( select_field:['b'01] & (VREG_D10) )                // second pixel
          #( select_field:['b'10] & (VREG_D18) )               // third pixel 
          #( select_field:['b'11] & (VREG_D26) );              // fourth pixel
         

GREENb1 =  ( select_field:['b'00] & (VREG_D3) )                // first pixel
          #( select_field:['b'01] & (VREG_D11) )                // second pixel
          #( select_field:['b'10] & (VREG_D19) )               // third pixel 
          #( select_field:['b'11] & (VREG_D27) );              // fourth pixel
         

BLUEb0ORb1 = ( select_field:['b'00] & (VREG_D4#VREG_D5) )                 // first pixel
            #( select_field:['b'01] & (VREG_D12#VREG_D13) )                 // second pixel
            #( select_field:['b'10] & (VREG_D20#VREG_D21) )               // third pixel 
            #( select_field:['b'11] & (VREG_D28#VREG_D29) );              // fourth pixel

BLUEb0 =  ( select_field:['b'00] & (VREG_D4) )                // first pixel
          #( select_field:['b'01] & (VREG_D12) )                // second pixel
          #( select_field:['b'10] & (VREG_D20) )               // third pixel 
          #( select_field:['b'11] & (VREG_D28) );              // fourth pixel
         

BLUEb1 =  ( select_field:['b'00] & (VREG_D5) )                // first pixel
          #( select_field:['b'01] & (VREG_D13) )                // second pixel
          #( select_field:['b'10] & (VREG_D21) )               // third pixel 
          #( select_field:['b'11] & (VREG_D29) );              // fourth pixel

                                             
TEXT_MODE = mode_field:['b'00];
GRAPHICS_16BPP_MODE = mode_field:['b'10];
GRAPHICS_8BPP_MODE =  mode_field:['b'11];

/*  These are the expressions for the final video output signals, per color. Each color is 5 bits of output
    and that output is based on the _MODE variables.    

    For TEXT_MODE, we used the SREG_D7 (which is the pixel being driven) to either output the value from the
    attribute register bit 0 (the forground RED0) or attribute register bit 9 (the background RED0).  This is
    repeated for each bit of each color, and this allows the TEXT_MODE to have 32 background colors and 32 
    foreground colors.   

    We still need to figure out how to do INVERT. 

    INVERTCHAR is used to INVERT a character to represent the cursor.  It uses an external BLINK_TIMER input
    to turn it off and on - External pulse needs to be provided to the BLINK_TIMER. AREG_D23 is the bit to
    indicate the location of the cursor.
*/


PINNODE = INVERTCHAR;
INVERTCHAR = (BLINK_TIMER & AREG_D23);

RED0 = VGA_ENABLE & ( 
                      ( TEXT_MODE & (((SREG_D7 & AREG_D0) # (!SREG_D7 & AREG_D9)) $ INVERTCHAR ))              // MODE=00, TEXT MODE
                    # ( GRAPHICS_16BPP_MODE & ((select_field:['b'X0] & VREG_D0 ) # (select_field:['b'X1] & VREG_D16)))
                    # ( GRAPHICS_8BPP_MODE & (REDb0ORb1))
                    );

RED1 = VGA_ENABLE & ( 
                    ( TEXT_MODE & (((SREG_D7 & AREG_D0) # (!SREG_D7 & AREG_D9)) $ INVERTCHAR ))              // MODE=00, TEXT MODE
                    # ( GRAPHICS_16BPP_MODE & ((select_field:['b'X0] & VREG_D1 ) # (select_field:['b'X1] & VREG_D17))) // MODE=10, 16bpp Graphics
                    # ( GRAPHICS_8BPP_MODE & (REDb0))
                    );

RED2 = VGA_ENABLE & ( 
                    ( TEXT_MODE & (((SREG_D7 & AREG_D0) # (!SREG_D7 & AREG_D9))  $ INVERTCHAR ))              // MODE=00, TEXT MODE
                    # ( GRAPHICS_16BPP_MODE & ((select_field:['b'X0] & VREG_D2 ) # (select_field:['b'X1] & VREG_D18))) // MODE=10, 16bpp Graphics
                    # ( GRAPHICS_8BPP_MODE & (REDb1))
                    );

RED3 = VGA_ENABLE & ( 
                    ( TEXT_MODE & (((SREG_D7 & AREG_D1) # (!SREG_D7 & AREG_D10))  $ INVERTCHAR ))              // MODE=00, TEXT MODE
                    # ( GRAPHICS_16BPP_MODE & ((select_field:['b'X0] & VREG_D3 ) # (select_field:['b'X1] & VREG_D19))) // MODE=10, 16bpp Graphics
                    # ( GRAPHICS_8BPP_MODE & (REDb0))
                    );

RED4 = VGA_ENABLE & ( 
                    ( TEXT_MODE & (((SREG_D7 & AREG_D2) # (!SREG_D7 & AREG_D11))  $ INVERTCHAR ))  // MODE=00, TEXT MODE
                    # ( GRAPHICS_16BPP_MODE & ((select_field:['b'X0] & VREG_D4 ) # (select_field:['b'X1] & VREG_D20))) // MODE=10, 16bpp Graphics
                    # ( GRAPHICS_8BPP_MODE & (REDb1))
                    );


GREEN0 = VGA_ENABLE & ( 
                    ( TEXT_MODE & (((SREG_D7 & AREG_D3) # (!SREG_D7 & AREG_D12))  $ INVERTCHAR ))              // MODE=00, TEXT MODE
                    # ( GRAPHICS_16BPP_MODE & ((select_field:['b'X0] & VREG_D5 ) # (select_field:['b'X1] & VREG_D21))) // MODE=10, 16bpp Graphics
                    # ( GRAPHICS_8BPP_MODE & (GREENb0ORb1)) 
                    );

GREEN1 = VGA_ENABLE & ( 
                    ( TEXT_MODE & (((SREG_D7 & AREG_D3) # (!SREG_D7 & AREG_D12)) $ INVERTCHAR ) )              // MODE=00, TEXT MODE
                    # ( GRAPHICS_16BPP_MODE & ((select_field:['b'X0] & VREG_D6 ) # (select_field:['b'X1] & VREG_D22))) // MODE=10, 16bpp Graphics
                    # ( GRAPHICS_8BPP_MODE & (GREENb0)) 
                    );

GREEN2 = VGA_ENABLE & ( 
                    ( TEXT_MODE & (((SREG_D7 & AREG_D3) # (!SREG_D7 & AREG_D12)) $ INVERTCHAR ))              // MODE=00, TEXT MODE
                    # ( GRAPHICS_16BPP_MODE & ((select_field:['b'X0] & VREG_D7 ) # (select_field:['b'X1] & VREG_D23))) // MODE=10, 16bpp Graphics
                    # ( GRAPHICS_8BPP_MODE & (GREENb1))
                    );

GREEN3 = VGA_ENABLE & ( 
                    ( TEXT_MODE & (((SREG_D7 & AREG_D4) # (!SREG_D7 & AREG_D13)) $ INVERTCHAR ) )              // MODE=00, TEXT MODE
                    # ( GRAPHICS_16BPP_MODE & ((select_field:['b'X0] & VREG_D8 ) # (select_field:['b'X1] & VREG_D24))) // MODE=10, 16bpp Graphics
                    # ( GRAPHICS_8BPP_MODE & (GREENb0))
                    );

GREEN4 = VGA_ENABLE & ( 
                    ( TEXT_MODE & (((SREG_D7 & AREG_D5) # (!SREG_D7 & AREG_D14))  $ INVERTCHAR ))   // MODE=00, TEXT MODE
                    # ( GRAPHICS_16BPP_MODE & ((select_field:['b'X0] & VREG_D9 ) # (select_field:['b'X1] & VREG_D25))) // MODE=10, 16bpp Graphics
                    # ( GRAPHICS_8BPP_MODE & (GREENb1))
                    );

BLUE0 = VGA_ENABLE & ( 
                    ( TEXT_MODE & (((SREG_D7 & AREG_D6) # (!SREG_D7 & AREG_D15))$ INVERTCHAR ))              // MODE=00, TEXT MODE
                    # ( GRAPHICS_16BPP_MODE & ((select_field:['b'X0] & VREG_D10 ) # (select_field:['b'X1] & VREG_D26))) // MODE=10, 16bpp Graphics
                    # ( GRAPHICS_8BPP_MODE & (BLUEb0ORb1))
                    );

BLUE1 = VGA_ENABLE & ( 
                    ( TEXT_MODE & (((SREG_D7 & AREG_D6) # (!SREG_D7 & AREG_D15))$ INVERTCHAR ) )              // MODE=00, TEXT MODE
                    # ( GRAPHICS_16BPP_MODE & ((select_field:['b'X0] & VREG_D11 ) # (select_field:['b'X1] & VREG_D27))) // MODE=10, 16bpp Graphics
                    # ( GRAPHICS_8BPP_MODE & (BLUEb0)) 
                    );

BLUE2 = VGA_ENABLE & ( 
                    ( TEXT_MODE & (((SREG_D7 & AREG_D6) # (!SREG_D7 & AREG_D15))$ INVERTCHAR ) )              // MODE=00, TEXT MODE
                    # ( GRAPHICS_16BPP_MODE & ((select_field:['b'X0] & VREG_D12 ) # (select_field:['b'X1] & VREG_D28))) // MODE=10, 16bpp Graphics
                    # ( GRAPHICS_8BPP_MODE & (BLUEb1)) 
                    );

BLUE3 = VGA_ENABLE & ( 
                    ( TEXT_MODE & (((SREG_D7 & AREG_D7) # (!SREG_D7 & AREG_D16))$ INVERTCHAR ) )              // MODE=00, TEXT MODE
                    # ( GRAPHICS_16BPP_MODE & ((select_field:['b'X0] & VREG_D13 ) # (select_field:['b'X1] & VREG_D29))) // MODE=10, 16bpp Graphics
                    # ( GRAPHICS_8BPP_MODE & (BLUEb0)) 
                    );

BLUE4 = VGA_ENABLE & ( 
                    ( TEXT_MODE & (((SREG_D7 & AREG_D8) # (!SREG_D7 & AREG_D17)) $ INVERTCHAR ))  // MODE=00, TEXT MODE
                    # ( GRAPHICS_16BPP_MODE & ((select_field:['b'X0] & VREG_D14 ) # (select_field:['b'X1] & VREG_D30))) // MODE=10, 16bpp Graphics
                    # ( GRAPHICS_8BPP_MODE & (BLUEb1)) 
                    );


/*

Total dedicated input used:	3/4 	(75%)
Total I/O pins used		80/80 	(100%)
Total Logic cells used 		110/128 	(85%)
Total Flip-Flop used 		64/128 	(50%)
Total Foldback logic used 	7/128 	(5%)
Total Nodes+FB/MCells 		117/128 	(91%)
Total cascade used 		0
Total input pins 		56
Total output pins 		27
Total Pts 			331
*/