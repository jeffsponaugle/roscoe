Name	 PTC;
PartNo   PTC;
Date     07/24/2025;
Revision 4;
Designer Sponaugle;
Company  Ratiometric;
Assembly None;
Location None;
Device    f1504isptqfp44;

PROPERTY ATMEL {TDI_PULLUP = ON};
PROPERTY ATMEL {TMS_PULLUP = ON};
PROPERTY ATMEL {PREASSIGN = KEEP};

//      VERSION 1 - First Pass at Rev2


/* 
                                                Inputs
    ##########################################################################################
*/

/* Generic Pins used by both counters */

PIN[39] = nSYS_RESET;
PIN[2,3,5,6,18,19,20,21,22,23,25,31,33,34,35,44] = [D0..15];
PIN[27] = nPTC_CS;
PIN[15] = nPTC_RW;   /* _RW 0=W, 1=R */
PIN[14] = nPTC_A2;   /* A2 for read select to read both counters */

/* 32Khz Clock Input */

PIN[40] = PTC_32K_CLOCK;


/* CPU_CLK input */

PIN[37] = CPU_CLOCK_div2;

/* 
   Output pins to the interrupt controller CPLD.  One will be used to signal an interrupt, and the other will be used 
   to bring the RTC SQW signal to this CPLD 
*/
PIN[43] = nINTA_OUT;
PIN[42] = nRTC_SQW_IN;     // On the INTCPLD side this is INT5B.


/* Flip flops used by TIMER A */

PINNODE = [PTCA_TIMER0..19];        // The timer itself
PINNODE = PTCA_MIDCLOCKA;
PINNODE = PTCA_MIDCLOCKB;
PINNODE = PTCA_TIMER_RESET;

PINNODE = [PTCA_OUTPUT0..19];       // The copy of the timer that is clocked on the opposite clock edge as the counter itself




[D0..15].oe = !(nPTC_CS # !nPTC_RW);
[D0..3] = (!nPTC_A2 & [PTCA_OUTPUT0..3]) # (nPTC_A2 & [PTCA_OUTPUT16..19]);
[D4..15] = (!nPTC_A2 & [PTCA_OUTPUT4..15]);



/* We need to take in the RTC signal, and double clock it to sync up with the CPU_CPK input. */

PINNODE = RTC_CAPTURE;
PINNODE = RTC_OUTPUT;

// Create a /2, /4, /8, and /16 CPU_CLK

PINNODE = CPU_CLOCK_div4;
PINNODE = CPU_CLOCK_div8;
PINNODE = CPU_CLOCK_div16;


CPU_CLOCK_div4.d = !CPU_CLOCK_div4;
CPU_CLOCK_div4.ck = CPU_CLOCK_div2;
CPU_CLOCK_div4.ar = !nSYS_RESET;

CPU_CLOCK_div8.d = !CPU_CLOCK_div8;
CPU_CLOCK_div8.ck = CPU_CLOCK_div4;
CPU_CLOCK_div8.ar = !nSYS_RESET;

CPU_CLOCK_div16.d = !CPU_CLOCK_div16;
CPU_CLOCK_div16.ck = CPU_CLOCK_div8;
CPU_CLOCK_div16.ar = !nSYS_RESET;

// We need a set of clock signals for the cascaded counters.  Each stage of the counter needs a clock that flips after the previous stage
// We are going to use the div16 clock as the core signal to increment the counter.


/* The first flipflop is reset to 0 at system reset, then on the rising edge of the RTC SQW input it is latched to 1.  The output of that
   flip flop goes into the OUTPUT flipflop, and that flipflop is captured on the rising edge of the CPU_CLK.  That output is then sent 
   on to the interrupt controller, but now that signal is synced with the CPU clock.  The first flopflop (capture) is reset as soon as 
   this second flip flip goes high, when means on the next CPU clock the second flip flop will go low, and we are back to the starting point
   waiting for the next RTC SQW signal.
*/

RTC_CAPTURE.d = 'b'1;
RTC_CAPTURE.ck = nRTC_SQW_IN;
RTC_CAPTURE.ar = RTC_OUTPUT # !nSYS_RESET;

RTC_OUTPUT.d = RTC_CAPTURE;
RTC_OUTPUT.ck = CPU_CLOCK_div16;
RTC_OUTPUT.ar = !nSYS_RESET;

/* Set the interrupt low (low edge triggered) if the TIMERx_RATE = 001 AND PCTx_TIMER4 is also = 1 */
nINTA_OUT =   !(PTCA_TIMER15);


/* 
   Create an 20 bit timer TIMER A 

   The counter is composed of 20 bits, with the first 6 bits as a counter, and that counter triggers
   the second 6 bit counter, which then triggers a third 8 bit counter.  The reason for having three cascaded 6/8 bit counters is due to resource 
   constraints in the CPLD.  3 6/8 bit counters with a cascade uses less logic space compared to a single
   20 bit counter. 

*/


/* PTCA_FX indicates if the next bit should flip as a result of all of the lower bits being 1 */

PTCA_F1 = PTCA_TIMER1 & PTCA_TIMER0;		/* if ==1, then bit 2 should flip */
PTCA_F2 = PTCA_TIMER2 & PTCA_F1;
PTCA_F3 = PTCA_TIMER3 & PTCA_F2;
PTCA_F4 = PTCA_TIMER4 & PTCA_F3;
PTCA_F5 = PTCA_TIMER5 & PTCA_F4;

/* There is no F6, since F6 is a restart of a second offset clocked timer */
PTCA_F7 = PTCA_TIMER7 & PTCA_TIMER6;
PTCA_F8 = PTCA_TIMER8 & PTCA_F7;
PTCA_F9 = PTCA_TIMER9 & PTCA_F8;
PTCA_F10 = PTCA_TIMER10 & PTCA_F9;
PTCA_F11 = PTCA_TIMER11 & PTCA_F10;
PTCA_F12 = PTCA_TIMER11 & PTCA_F11;

/* There is no F13, since F13 is a restart of a second offset clocked timer */

PTCA_F14 = PTCA_TIMER14 & PTCA_TIMER13;
PTCA_F15 = PTCA_TIMER15 & PTCA_F14;
PTCA_F16 = PTCA_TIMER16 & PTCA_F15;
PTCA_F17 = PTCA_TIMER17 & PTCA_F16;
PTCA_F18 = PTCA_TIMER18 & PTCA_F17;
PTCA_F19 = PTCA_TIMER19 & PTCA_F18;


/* 
    There are two mid clocks.  The first is to increment the middle 6 bits, and it does that by using dev8 and div4 to select 
    the first part of a div2 cycle where div16,8, and 4 are high.  That happens first.

    The second stage of the counter is incremented in the second part of the div2 cycle where div16 and div8 are high but div 4 is low.
    That means all stages of the counter are incremented before the end of div16s high state, which is then when the OUTPUT flipflops
    grab the value. 

*/
PTCA_MIDCLOCKA.d = PTCA_F5 & CPU_CLOCK_div16 & CPU_CLOCK_div8 & CPU_CLOCK_div4;
PTCA_MIDCLOCKA.ck = CPU_CLOCK_div2;
PTCA_MIDCLOCKA.ar =  RTC_OUTPUT # !nSYS_RESET;

PTCA_MIDCLOCKB.d = PTCA_F10 & CPU_CLOCK_div16 & CPU_CLOCK_div8 & !CPU_CLOCK_div4;
PTCA_MIDCLOCKB.ck = CPU_CLOCK_div2;
PTCA_MIDCLOCKB.ar =  RTC_OUTPUT # !nSYS_RESET;

/* Lower Part of Counter */
PTCA_TIMER0.d = !PTCA_TIMER0;
PTCA_TIMER1.d = ( PTCA_TIMER1 $ PTCA_TIMER0 );
PTCA_TIMER2.d = ( PTCA_TIMER2 & !(PTCA_F1))
                 # ( !PTCA_TIMER2 & (PTCA_F1) );
PTCA_TIMER3.d = ( PTCA_TIMER3 & !(PTCA_F2))
                 # ( !PTCA_TIMER3 & (PTCA_F2) );
PTCA_TIMER4.d = ( PTCA_TIMER4 & !(PTCA_F3))
                 # ( !PTCA_TIMER4 & (PTCA_F3) );
PTCA_TIMER5.d = ( PTCA_TIMER5 & !(PTCA_F4))
                 # ( !PTCA_TIMER5 & (PTCA_F4) );

/* Middle Part of Counter */
PTCA_TIMER6.d = !PTCA_TIMER6;
PTCA_TIMER7.d = ( PTCA_TIMER7 $ PTCA_TIMER6 );
PTCA_TIMER8.d = ( PTCA_TIMER8 & !(PTCA_F7))
                 # ( !PTCA_TIMER8 & (PTCA_F7) );
PTCA_TIMER9.d = ( PTCA_TIMER9 & !(PTCA_F8))
                 # ( !PTCA_TIMER9 & (PTCA_F8) );
PTCA_TIMER10.d = ( PTCA_TIMER10 & !(PTCA_F9))
                 # ( !PTCA_TIMER10 & (PTCA_F9) );
PTCA_TIMER11.d = ( PTCA_TIMER11 & !(PTCA_F10))
                 # ( !PTCA_TIMER11 & (PTCA_F10) );
PTCA_TIMER12.d = ( PTCA_TIMER12 & !(PTCA_F11))
                 # ( !PTCA_TIMER12 & (PTCA_F11) );

 /* Upper Part of Counter */


PTCA_TIMER13.d = !PTCA_TIMER13;
PTCA_TIMER14.d = ( PTCA_TIMER14 $ PTCA_TIMER13 );
PTCA_TIMER15.d = ( PTCA_TIMER15 & !(PTCA_F14))
                 # ( !PTCA_TIMER15 & (PTCA_F14) );
PTCA_TIMER16.d = ( PTCA_TIMER16 & !(PTCA_F15))
                 # ( !PTCA_TIMER16 & (PTCA_F15) );
PTCA_TIMER17.d = ( PTCA_TIMER17 & !(PTCA_F16))
                 # ( !PTCA_TIMER17 & (PTCA_F16) );

PTCA_TIMER18.d = ( PTCA_TIMER18 & !(PTCA_F17))
                 # ( !PTCA_TIMER18 & (PTCA_F17) );

PTCA_TIMER19.d = ( PTCA_TIMER18 & !(PTCA_F18))
                 # ( !PTCA_TIMER18 & (PTCA_F18) );

[PTCA_TIMER0..5].ck = CPU_CLOCK_div16;
[PTCA_TIMER6..12].ck = PTCA_MIDCLOCKA;
[PTCA_TIMER13..19].ck = PTCA_MIDCLOCKB;
/* if the INT1_OUT pin goes low, lets reset the counter and start counting again to the next interrupt */
[PTCA_TIMER0..19].ar = RTC_OUTPUT # !nSYS_RESET;

[PTCA_OUTPUT0..19].d = [PTCA_TIMER0..19];
[PTCA_OUTPUT0..19].ck = !CPU_CLOCK_div16;
[PTCA_OUTPUT0..19].ar = RTC_OUTPUT # !nSYS_RESET;

/*

6/6/8 20bit counter

Total dedicated input used:	2/4 	(50%)
Total I/O pins used		25/32 	(78%)
Total Logic cells used 		64/64 	(100%)
Total Flip-Flop used 		47/64 	(73%)
Total Foldback logic used 	17/64 	(26%)
Total Nodes+FB/MCells 		81/64 	(126%)
Total cascade used 		0
Total input pins 		10
Total output pins 		17
Total Pts 			204

*/
