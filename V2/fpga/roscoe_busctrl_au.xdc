## roscoe_busctrl_au.xdc - Roscoe 68030 core logic on an Alchitry Au V2 (XC7A35T-FTG256) on a Br Wide V2.
##
## GENERATED by gen-xdc.ps1 from Roscoe_FPGA_pinmap_AuV2.xlsx ("FPGA pins" sheet). Do not edit by hand:
## change the workbook, then run   powershell -ExecutionPolicy Bypass -File fpga\gen-xdc.ps1
## 101 signals: 49 inputs, 44 outputs, 8 bidirectional. Design notes: Roscoe_FPGA_Redesign.md.
##
## Every pin is LVCMOS33. Bank 34 is only at 3.3V while VBSEL_A/B (Br J19-4, J20-4) are left unconnected.
## Outputs use SLEW SLOW / DRIVE 8: the 0.1" headers have one ground per 13 signals (section 12).

## ---- Configuration: CFGBVS is tied to VCCO on the Au; Master SPI x4 from the on-board QSPI flash ----
set_property CFGBVS VCCO [current_design]
set_property CONFIG_VOLTAGE 3.3 [current_design]
set_property BITSTREAM.CONFIG.SPI_BUSWIDTH 4 [current_design]
set_property BITSTREAM.GENERAL.COMPRESS TRUE [current_design]

## ---- Clocks ----
## CPU_CLK period for the Y1 fitted today (16 MHz). Regenerate with -CpuClkPeriodNs for another oscillator.
create_clock -period 62.500 -name cpu_clk [get_ports cpu_clk]

## ---- I/O timing ----
## In roscoe_timing.xdc (hand-written; read it after this file): set_input_delay / set_output_delay against
## cpu_clk from the 68030 bus timing and the translator delays (Roscoe_FPGA_Redesign.md section 16).

## ---- Pins:  port  <-  Roscoe pin (1-136), Br hole, Au pin, carrier part and channel, 5V-side net ----

## CPU clock: Y1 -> U_CLK (74LVC1G34) -> 33R -> MRCC pin A41. Keep A39 (its N partner) empty, A47 static, A33/A45 slow or static.
set_property -dict {PACKAGE_PIN D4 IOSTANDARD LVCMOS33} [get_ports {cpu_clk}]                ;# pin  22  J8-8 A41 U_CLK ch1          CPU CLK (33R series at U_CLK out)

## Address A8-A15 (U_IN1, 74LVC244A)
set_property -dict {PACKAGE_PIN P10 IOSTANDARD LVCMOS33} [get_ports {cpu_a_hi[8]}]           ;# pin  78  J12-8 B41 U_IN1 ch1         A8
set_property -dict {PACKAGE_PIN N11 IOSTANDARD LVCMOS33} [get_ports {cpu_a_hi[9]}]           ;# pin  79  J12-9 B47 U_IN1 ch2         A9
set_property -dict {PACKAGE_PIN M2 IOSTANDARD LVCMOS33} [get_ports {cpu_a_hi[10]}]           ;# pin  80  J12-10 B53 U_IN1 ch3        A10
set_property -dict {PACKAGE_PIN N3 IOSTANDARD LVCMOS33} [get_ports {cpu_a_hi[11]}]           ;# pin  81  J12-11 B59 U_IN1 ch4        A11
set_property -dict {PACKAGE_PIN P4 IOSTANDARD LVCMOS33} [get_ports {cpu_a_hi[12]}]           ;# pin  82  J12-12 B65 U_IN1 ch5        A12
set_property -dict {PACKAGE_PIN L4 IOSTANDARD LVCMOS33} [get_ports {cpu_a_hi[13]}]           ;# pin  83  J12-13 B71 U_IN1 ch6        A13
set_property -dict {PACKAGE_PIN P5 IOSTANDARD LVCMOS33} [get_ports {cpu_a_hi[14]}]           ;# pin  84  J12-14 B77 U_IN1 ch7        A14
set_property -dict {PACKAGE_PIN E6 IOSTANDARD LVCMOS33} [get_ports {cpu_a_hi[15]}]           ;# pin  77  J12-7 B35 U_IN1 ch8         A15

## Address A16-A23 (U_IN2)
set_property -dict {PACKAGE_PIN H4 IOSTANDARD LVCMOS33} [get_ports {cpu_a_hi[16]}]           ;# pin  34  J9-6 A28 U_IN2 ch1          A16
set_property -dict {PACKAGE_PIN J4 IOSTANDARD LVCMOS33} [get_ports {cpu_a_hi[17]}]           ;# pin  35  J9-7 A34 U_IN2 ch2          A17
set_property -dict {PACKAGE_PIN D3 IOSTANDARD LVCMOS33} [get_ports {cpu_a_hi[18]}]           ;# pin  36  J9-8 A40 U_IN2 ch3          A18
set_property -dict {PACKAGE_PIN F3 IOSTANDARD LVCMOS33} [get_ports {cpu_a_hi[19]}]           ;# pin  37  J9-9 A46 U_IN2 ch4          A19
set_property -dict {PACKAGE_PIN D5 IOSTANDARD LVCMOS33} [get_ports {cpu_a_hi[20]}]           ;# pin  38  J9-10 A52 U_IN2 ch5         A20
set_property -dict {PACKAGE_PIN B1 IOSTANDARD LVCMOS33} [get_ports {cpu_a_hi[21]}]           ;# pin  39  J9-11 A58 U_IN2 ch6         A21
set_property -dict {PACKAGE_PIN A2 IOSTANDARD LVCMOS33} [get_ports {cpu_a_hi[22]}]           ;# pin  40  J9-12 A64 U_IN2 ch7         A22
set_property -dict {PACKAGE_PIN C6 IOSTANDARD LVCMOS33} [get_ports {cpu_a_hi[23]}]           ;# pin  41  J9-13 A70 U_IN2 ch8         A23

## Address A24-A31 (U_IN3)
set_property -dict {PACKAGE_PIN N9 IOSTANDARD LVCMOS33} [get_ports {cpu_a_hi[24]}]           ;# pin  44  J10-2 A6 U_IN3 ch1          A24
set_property -dict {PACKAGE_PIN H5 IOSTANDARD LVCMOS33} [get_ports {cpu_a_hi[25]}]           ;# pin  48  J10-6 A30 U_IN3 ch2         A25
set_property -dict {PACKAGE_PIN J5 IOSTANDARD LVCMOS33} [get_ports {cpu_a_hi[26]}]           ;# pin  49  J10-7 A36 U_IN3 ch3         A26
set_property -dict {PACKAGE_PIN E3 IOSTANDARD LVCMOS33} [get_ports {cpu_a_hi[27]}]           ;# pin  50  J10-8 A42 U_IN3 ch4         A27
set_property -dict {PACKAGE_PIN F4 IOSTANDARD LVCMOS33} [get_ports {cpu_a_hi[28]}]           ;# pin  51  J10-9 A48 U_IN3 ch5         A28
set_property -dict {PACKAGE_PIN D6 IOSTANDARD LVCMOS33} [get_ports {cpu_a_hi[29]}]           ;# pin  52  J10-10 A54 U_IN3 ch6        A29
set_property -dict {PACKAGE_PIN C1 IOSTANDARD LVCMOS33} [get_ports {cpu_a_hi[30]}]           ;# pin  53  J10-11 A60 U_IN3 ch7        A30
set_property -dict {PACKAGE_PIN B2 IOSTANDARD LVCMOS33} [get_ports {cpu_a_hi[31]}]           ;# pin  54  J10-12 A66 U_IN3 ch8        A31

## A0, A1, SIZ0/1, FC0-2, R/W (U_IN4)
set_property -dict {PACKAGE_PIN N6 IOSTANDARD LVCMOS33} [get_ports {cpu_a_lo[0]}]            ;# pin   2  J7-2 A3 U_IN4 ch1           A0
set_property -dict {PACKAGE_PIN J1 IOSTANDARD LVCMOS33} [get_ports {cpu_a_lo[1]}]            ;# pin   3  J7-3 A9 U_IN4 ch2           A1
set_property -dict {PACKAGE_PIN G4 IOSTANDARD LVCMOS33} [get_ports {cpu_fc[0]}]              ;# pin   6  J7-6 A27 U_IN4 ch5          FC0
set_property -dict {PACKAGE_PIN C3 IOSTANDARD LVCMOS33} [get_ports {cpu_fc[1]}]              ;# pin  27  J8-13 A71 U_IN4 ch6         FC1
set_property -dict {PACKAGE_PIN K1 IOSTANDARD LVCMOS33} [get_ports {cpu_fc[2]}]              ;# pin  17  J8-3 A11 U_IN4 ch7          FC2
set_property -dict {PACKAGE_PIN H2 IOSTANDARD LVCMOS33} [get_ports {cpu_rw}]                 ;# pin  18  J8-4 A17 U_IN4 ch8          R/~W
set_property -dict {PACKAGE_PIN H1 IOSTANDARD LVCMOS33} [get_ports {cpu_siz[0]}]             ;# pin   4  J7-4 A15 U_IN4 ch3          SIZ0
set_property -dict {PACKAGE_PIN E1 IOSTANDARD LVCMOS33} [get_ports {cpu_siz[1]}]             ;# pin   5  J7-5 A21 U_IN4 ch4          SIZ1

## AS, CBREQ, SYS_RESET, EXP_ACK, A2, A3, IDE IORDY, power request (U_IN5)
set_property -dict {PACKAGE_PIN G5 IOSTANDARD LVCMOS33} [get_ports {cbreq_n}]                ;# pin  20  J8-6 A29 U_IN5 ch2          ~CBREQ (68030 cache burst request; not routed on V2)
set_property -dict {PACKAGE_PIN A7 IOSTANDARD LVCMOS33} [get_ports {cpu_a_lo[2]}]            ;# pin  42  J9-14 A76 U_IN5 ch5         A2
set_property -dict {PACKAGE_PIN C7 IOSTANDARD LVCMOS33} [get_ports {cpu_a_lo[3]}]            ;# pin  55  J10-13 A72 U_IN5 ch6        A3
set_property -dict {PACKAGE_PIN F2 IOSTANDARD LVCMOS33} [get_ports {cpu_as_n}]               ;# pin  19  J8-5 A23 U_IN5 ch1          ~AS
set_property -dict {PACKAGE_PIN B5 IOSTANDARD LVCMOS33} [get_ports {exp_ack_n}]              ;# pin  14  J7-14 A75 U_IN5 ch4         ~EXP_ACK (slots A26, 1K pull-up)
set_property -dict {PACKAGE_PIN R10 IOSTANDARD LVCMOS33} [get_ports {ide_iordy}]             ;# pin  76  J12-6 B29 U_IN5 ch7         IDE IORDY (J4/J6 pin 27, 1K pull-up to +5V)
set_property -dict {PACKAGE_PIN F5 IOSTANDARD LVCMOS33} [get_ports {pwr_req}]                ;# pin  23  J8-9 A47 U_IN5 ch8          POWER_CONTROL_OUT (AVR U65 PWR_REQGR; R9/R46 10K pull-downs). Active high.
set_property -dict {PACKAGE_PIN G2 IOSTANDARD LVCMOS33} [get_ports {sys_reset_n}]            ;# pin  21  J8-7 A35 U_IN5 ch3          ~SYS_RESET (from IOCTRL)

## Interrupt inputs from U_IN6 (100R series) on the Au LED0-7 pins (control headers J17-J20); each pin also drives an Au LED through 330R. Polarity is handled in the FPGA.
set_property -dict {PACKAGE_PIN M14 IOSTANDARD LVCMOS33} [get_ports {irq_exp_n[0]}]          ;# pin 132  J20-2 C32 U_IN6 ch6         ~EXP_IRQ1 (connector B21, bussed to every slot; was nEXP_INT3A)
set_property -dict {PACKAGE_PIN M12 IOSTANDARD LVCMOS33} [get_ports {irq_exp_n[1]}]          ;# pin 127  J19-3 C34 U_IN6 ch7         ~EXP_IRQ2 (connector A23, bussed to every slot; was nEXP_INT3B)
set_property -dict {PACKAGE_PIN P14 IOSTANDARD LVCMOS33} [get_ports {irq_exp_n[2]}]          ;# pin 133  J20-3 C36 U_IN6 ch8         ~EXP_IRQ3 (connector A24, bussed to every slot; was nEXP_INT2A)
set_property -dict {PACKAGE_PIN K13 IOSTANDARD LVCMOS33} [get_ports {irq_ide[0]}]            ;# pin 114  J17-2 C29 U_IN6 ch1         IDE1 INTRQ (J4-31)
set_property -dict {PACKAGE_PIN K12 IOSTANDARD LVCMOS33} [get_ports {irq_ide[1]}]            ;# pin 120  J18-2 C31 U_IN6 ch2         IDE2 INTRQ (J6-31)
set_property -dict {PACKAGE_PIN M15 IOSTANDARD LVCMOS33} [get_ports {irq_rtc_n}]             ;# pin 126  J19-2 C30 U_IN6 ch5         ~RTC IRQ (U33)
set_property -dict {PACKAGE_PIN L14 IOSTANDARD LVCMOS33} [get_ports {irq_uart[0]}]           ;# pin 115  J17-3 C33 U_IN6 ch3         UART INTA (U36)
set_property -dict {PACKAGE_PIN L13 IOSTANDARD LVCMOS33} [get_ports {irq_uart[1]}]           ;# pin 121  J18-3 C35 U_IN6 ch4         UART INTB (U36)

## D24-D31 through U_DATA (74LVC245A, DIR = CPU R/W), and its /OE
set_property -dict {PACKAGE_PIN R1 IOSTANDARD LVCMOS33 SLEW SLOW DRIVE 8} [get_ports {cpu_d[24]}] ;# pin  95  J13-11 B58 U_DATA ch1       D24 (B side; A side to the FPGA)
set_property -dict {PACKAGE_PIN T2 IOSTANDARD LVCMOS33 SLEW SLOW DRIVE 8} [get_ports {cpu_d[25]}] ;# pin  96  J13-12 B64 U_DATA ch2       D25 (B side; A side to the FPGA)
set_property -dict {PACKAGE_PIN T3 IOSTANDARD LVCMOS33 SLEW SLOW DRIVE 8} [get_ports {cpu_d[26]}] ;# pin  97  J13-13 B70 U_DATA ch3       D26 (B side; A side to the FPGA)
set_property -dict {PACKAGE_PIN N4 IOSTANDARD LVCMOS33 SLEW SLOW DRIVE 8} [get_ports {cpu_d[27]}] ;# pin  98  J13-14 B76 U_DATA ch4       D27 (B side; A side to the FPGA)
set_property -dict {PACKAGE_PIN R2 IOSTANDARD LVCMOS33 SLEW SLOW DRIVE 8} [get_ports {cpu_d[28]}] ;# pin 109  J14-11 B60 U_DATA ch5       D28 (B side; A side to the FPGA)
set_property -dict {PACKAGE_PIN R3 IOSTANDARD LVCMOS33 SLEW SLOW DRIVE 8} [get_ports {cpu_d[29]}] ;# pin 110  J14-12 B66 U_DATA ch6       D29 (B side; A side to the FPGA)
set_property -dict {PACKAGE_PIN T4 IOSTANDARD LVCMOS33 SLEW SLOW DRIVE 8} [get_ports {cpu_d[30]}] ;# pin 111  J14-13 B72 U_DATA ch7       D30 (B side; A side to the FPGA)
set_property -dict {PACKAGE_PIN M5 IOSTANDARD LVCMOS33 SLEW SLOW DRIVE 8} [get_ports {cpu_d[31]}] ;# pin 112  J14-14 B78 U_DATA ch8       D31 (B side; A side to the FPGA)
set_property -dict {PACKAGE_PIN N1 IOSTANDARD LVCMOS33 SLEW SLOW DRIVE 8} [get_ports {data_oe_n}] ;# pin 108  J14-10 B54 U_DATA /OE       -> /OE (DIR = CPU R/W directly)

## U_CPU (74LVC244A): DSACK0/1 three-stated with their shared enable (group 1); STERM, CIIN, CBACK always driven (group 2)
set_property -dict {PACKAGE_PIN L3 IOSTANDARD LVCMOS33 SLEW SLOW DRIVE 8} [get_ports {cback_n}] ;# pin  45  J10-3 A12 U_CPU ch7         ~CBACK (group 2, /2OE = GND); floating on V2
set_property -dict {PACKAGE_PIN J3 IOSTANDARD LVCMOS33 SLEW SLOW DRIVE 8} [get_ports {ciin_n}] ;# pin  47  J10-5 A24 U_CPU ch6         ~CIIN (group 2, /2OE = GND)
set_property -dict {PACKAGE_PIN K3 IOSTANDARD LVCMOS33 SLEW SLOW DRIVE 8} [get_ports {dsack_d[0]}] ;# pin  46  J10-4 A18 U_CPU ch1         ~DSACK0 (group 1, /1OE = dsack_oe_n)
set_property -dict {PACKAGE_PIN L2 IOSTANDARD LVCMOS33 SLEW SLOW DRIVE 8} [get_ports {dsack_d[1]}] ;# pin  31  J9-3 A10 U_CPU ch2          ~DSACK1 (group 1, /1OE = dsack_oe_n)
set_property -dict {PACKAGE_PIN K2 IOSTANDARD LVCMOS33 SLEW SLOW DRIVE 8} [get_ports {dsack_oe_n}] ;# pin  32  J9-4 A16 U_CPU /1OE         -> /1OE (DSACK0/1; ch3-4 unused)
set_property -dict {PACKAGE_PIN H3 IOSTANDARD LVCMOS33 SLEW SLOW DRIVE 8} [get_ports {sterm_n}] ;# pin  33  J9-5 A22 U_CPU ch5          ~STERM (group 2, /2OE = GND)

## BERR, push-pull through U_MEM2 (74AHCT541), as BUSCTRL drives it today
set_property -dict {PACKAGE_PIN R13 IOSTANDARD LVCMOS33 SLEW SLOW DRIVE 8} [get_ports {berr_n}] ;# pin 102  J14-4 B18 U_MEM2 ch2        ~BERR (68030), push-pull as BUSCTRL drives it today

## IPL0-2 through U_MEM2 (74AHCT541)
set_property -dict {PACKAGE_PIN T9 IOSTANDARD LVCMOS33 SLEW SLOW DRIVE 8} [get_ports {ipl_n[0]}] ;# pin 100  J14-2 B6 U_MEM2 ch5         ~IPL0 (68030)
set_property -dict {PACKAGE_PIN M16 IOSTANDARD LVCMOS33 SLEW SLOW DRIVE 8} [get_ports {ipl_n[1]}] ;# pin 105  J14-7 B36 U_MEM2 ch6        ~IPL1 (68030)
