Name	 VGA_ADDR;
PartNo   VGA_ADDR;
Date     03/30/2024;
Revision 01;
Designer Sponaugle;
Company  Ratiometric;
Assembly None;
Location None;
Device   f1504isptqfp44;

PROPERTY ATMEL {TDI_PULLUP = ON};
PROPERTY ATMEL {TMS_PULLUP = ON};
PROPERTY ATMEL {PREASSIGN = KEEP};

Pin  = [VM_A0..17];         // The 18 address bits going to the video memory.  These are tri-state outputs.
                            // Each address has 4 bytes, so 18 address bits nets 1MB of video memory.
                            // at 640x480 16bpp a single frame is 614,400 bytes (1 page)
                            // at 640x480 8bpp a single frame is 307,200 bytes (3 pages)
                            // In text mode 80x30 with attribue is 4,800 bytes (218 pages)

Pin = VMEM_ADDR_RESET;      // Signal to reset the vidoe memory address.  This signal must be held high for a complete      
                            // DOT_CLOCK cycle, and will take effect on the rising edge of DOTCLOCK, just like other 
                            // changes to the video memory address. 

Pin = nVMEM_ADDR_OE;           // Output enable for the address lines to the VRAM
Pin = DOT_CLK;
Pin = nRESET;
Pin = [VMEM_ADDR_MODE1..0];
Pin = [VMEM_OFFSET7..0];        // 8 bits of memory address offset used for text mode and graphics mode.
                                //  In text mode this offset is in 256byte lines, so you can use it for
                                //  scrolling up to 256 lines.
                                //  In graphics mode it is used for pages of graphics

PINNODE = [C11..6];          /* Optimizing - Creating nodes for carry elements that are very large */
PINNODE = [S17..0];          /* Internal 17 bit counter for the memory address generation */

FIELD address_mode_field = [VMEM_VMEM_ADDR_MODE1..0];


/* 
    MODE 00(0) = Do Nothing
    MODE 01(1) = Increment by 1
    MODE 11(3) = Decrement by 40 ( 160 bytes or 80 characters, since memory is 32 bits wide )
    MODE 10(2) = Increment to the next /64 multiple ( zero out bits 0-5, add 0x0000 0000 0100 0000)

    Note Decrement by 40 is an extra (high) bit set from increment by 1.  This makes the generation logic for these bits easy to compute
    since the decrement by 40 happens on each font line until the last one.

    For Mode 2, the idea is to get to the next text mode line.  This assumes each text line that is 40 dwords of memory actually uses
    up 64 dwords of actual memory space.  The extra space after the 40 dwords is unused.  The reason for having each text line take a 
    power of 2 number of dwords is so we can use the VMEM_OFFSET variable to scroll a line at a time.   The VMEM_OFFSET is used during
    the address reset to start at the beginning of a specific line, and would not be possible in this CPLD if the text lines were all
    spaced 40 dwords apart.

    This means a standard 80x25 text display mode uses 25*64 dwords of memory (1600 dwords, or 6400 bytes), even though each text 
    row only uses 160 bytes of that memory.  The rest of the memory for each row is left unused.

*/


// The adder for the memory address

[S0..17].ck = DOT_CLK;      // UNSURE
[S0..17].ar = nRESET;

[VM_A17..0] = [S17..0];
[VM_A17..0].oe = !nVMEM_ADDR_OE;

/* Carry IN is 1 for increment by 1 mode, MODE=001 */
C0 = address_mode_field:['d'1];

// To subtract 40, we will add the 0b11 1111 1111 1101 1000, or 0x3FFD8
// To jump to the next mod 64 address, we will zero out bits 0-5, and then add 0b00 0000 0000 0100 0000

/* First 3 bits of add are always 0. */
[B0..2] = 'b'0;

/* Remaining bits are on for -80  */
B3 = address_mode_field:['d'3];
B4 = address_mode_field:['d'3];
B5 = 'b'0;
B6 = address_mode_field:['d'3] # address_mode_field:['d'2];
B7 = address_mode_field:['d'3];
B8 = address_mode_field:['d'3];
B9 = address_mode_field:['d'3];
B10 = address_mode_field:['d'3];
B11 = address_mode_field:['d'3];
B12 = address_mode_field:['d'3];
B13 = address_mode_field:['d'3];
B14 = address_mode_field:['d'3];
B15 = address_mode_field:['d'3];
B16 = address_mode_field:['d'3];
B17 = address_mode_field:['d'3];

CLEARLOWER = address_mode_field:['d'2];



